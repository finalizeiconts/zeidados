# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Copie para `.env` e preencha. SEM Supabase configurado, o app roda em modo
# demonstração (dados fictícios). Estas chaves são PÚBLICAS (vão no bundle):
# nunca coloque aqui o client_secret do Conta Azul nem a service_role key.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# URL da função que inicia o OAuth do Conta Azul (botão "Conectar"):
VITE_CA_CONNECT_URL=https://SEU-PROJETO.supabase.co/functions/v1/ca-auth-start

# Os segredos do Conta Azul (client_id, client_secret) e a service_role key NÃO
# ficam aqui — são secrets do Supabase (lado servidor). Veja o README:
#   supabase/set-secrets.example.sh  e  a seção "Ligando o Conta Azul".
